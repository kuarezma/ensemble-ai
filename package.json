{
  "name": "ensemble-ai",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Measured model delegation with reviewable, reversible tool rules",
  "main": "out/main/index.js",
  "bin": {
    "ensemble": "bin/ensemble"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:core && electron-vite build",
    "build:core": "tsc -p tsconfig.core.json",
    "dist": "npm run build && node scripts/dist.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:gate": "node scripts/ui-gate.mjs"
  },
  "dependencies": {
    "diff": "^8.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "desktopName": "ensemble.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuarezma/ensemble-ai.git"
  },
  "homepage": "https://github.com/kuarezma/ensemble-ai"
}
